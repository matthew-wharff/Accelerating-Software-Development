# Anthropic API key — required
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# e2b.dev sandbox API key — required for code execution
# Get from https://e2b.dev/dashboard
E2B_API_KEY=e2b_your-key-here

# GitHub Personal Access Token with 'repo' scope only — required for GitHub MCP
# Get from https://github.com/settings/tokens
GITHUB_PAT=ghp_your-token-here

# Pipeline mode — controls destructive side effects like GitHub repo creation
# Values: 'dry_run' (default, safe) or 'live' (actually creates repos)
# Defaults to 'dry_run' if unset
PIPELINE_MODE=dry_run

# Sandbox network egress policy — controls outbound network access from the e2b sandbox
# Values: 'true' (default, block egress) or 'false' (allow, e.g. for pip install)
# Defaults to 'true' if unset
SANDBOX_BLOCK_EGRESS=true
